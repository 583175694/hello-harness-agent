NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4318
WEB_ORIGIN=http://127.0.0.1:4317

# Auth: local = 固定 local-user（开发/测试）；required = Cookie 登录（生产必须）
AUTH_MODE=local
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=harness_session
AUTH_CODE_TTL_SECONDS=600
AUTH_SEND_CODE_MIN_INTERVAL_SEC=60

# 首次验码登录匹配邮箱/手机时升为 admin（可选）
# AUTH_BOOTSTRAP_ADMIN_EMAIL=
# AUTH_BOOTSTRAP_ADMIN_PHONE=
# 邮箱验证码（SMTP）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
#
# 手机验证码：阿里云号码认证 → 短信认证（控制台赠送签名+模板）
ALIYUN_SMS_AUTH_ACCESS_KEY_ID=
ALIYUN_SMS_AUTH_ACCESS_KEY_SECRET=
ALIYUN_SMS_AUTH_SIGN_NAME=
ALIYUN_SMS_AUTH_TEMPLATE_CODE=
LOG_LEVEL=info
ARTIFACT_ROOT=../../artifacts

# Model metadata lives in apps/api/src/model/model-catalog.ts.
OPENAI_API_KEY=
BAILIAN_API_KEY=

# Optional web search tool. Enable exactly one provider.
SEARCH_PROVIDER=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_API_KEY=
SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_SEARCH_API_KEY=

POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_local
POSTGRES_DB=harness
POSTGRES_PORT=5432
DATABASE_URL=postgresql://harness:harness_local@127.0.0.1:5432/harness?schema=public

VITE_API_BASE_URL=

#MCP: AES-256-GCM master key for encrypting user MCP credentials at rest.
HARNESS_SECRETS_MASTER_KEY=c5b5c7590b12d4c4da9fe7e38ef0559f94e59c260d82c344ddb0fe9b1341449c

# C1 image storage. Required when NODE_ENV=production.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=pipishrimp-1258195920
COS_REGION=ap-guangzhou

# C3 本地 OpenSandbox（dev/opensandbox-local/start.sh）。云上可改为 10.1.24.2:28473 或公网
SANDBOX_ENABLED=true
SANDBOX_DOMAIN=
SANDBOX_API_KEY=
SANDBOX_IMAGE=
