NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4318
WEB_ORIGIN=http://127.0.0.1:4317
LOG_LEVEL=info
ARTIFACT_ROOT=../../artifacts

# Model metadata lives in apps/api/src/model/model-catalog.ts.
OPENAI_API_KEY=
BAILIAN_API_KEY=

# Optional web search tool. Enable exactly one provider.
SEARCH_PROVIDER=
BOCHA_SEARCH_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_API_KEY=
SERPER_SEARCH_URL=https://google.serper.dev/search
SERPER_SEARCH_API_KEY=

POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_local
POSTGRES_DB=harness
POSTGRES_PORT=5432
DATABASE_URL=postgresql://harness:harness_local@127.0.0.1:5432/harness?schema=public

VITE_API_BASE_URL=

# C1 image storage. Required when NODE_ENV=production.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=pipishrimp-1258195920
COS_REGION=ap-guangzhou

# C3 OpenSandbox. Off unless enabled and Domain / API Key / image digest are all set.
# Local: ./dev/opensandbox-local/start.sh then 127.0.0.1:28473
SANDBOX_ENABLED=false
SANDBOX_DOMAIN=
SANDBOX_API_KEY=
# Image must include @sha256 digest. Default slim: see dev/opensandbox-local/README.md
# C3-D browser: harness-sandbox-browser:local@sha256:… after ./dev/opensandbox-local/build-browser-image.sh
SANDBOX_IMAGE=
# Browser deployments: give Docker Desktop 3–4GiB RAM for Chromium.
# Host domain allowlist after network approval (C3-C v2). Default off = open any URL in the command.
# Public/production deployments: set SANDBOX_EGRESS_HOST_ALLOWLIST_ENFORCED=true (open egress is for dev/open phase only).
# SANDBOX_EGRESS_HOST_ALLOWLIST_ENFORCED=true
# When enforced, extend fixed allowlist: SANDBOX_EGRESS_ALLOWLIST_EXTRA=zhihu.com
# SANDBOX_TTL_MS=
