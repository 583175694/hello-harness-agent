generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  kind        String   @default("local")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  sessions    Session[]
  messages    Message[]

  @@map("users")
}

enum MessageRole {
  user
  assistant
}

enum MessageKind {
  user_message
  assistant_delivery
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  title     String
  status    String    @default("active")
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  runs      AgentRun[]

  @@index([userId, isPinned(sort: Desc), updatedAt(sort: Desc)])
  @@map("sessions")
}

model Message {
  id        String      @id
  userId    String      @map("user_id")
  sessionId String      @map("session_id")
  role      MessageRole
  kind      MessageKind
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  metadata  Json        @default("{}")
  runId     String?     @map("run_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run       AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([runId])
  @@map("messages")
}

model AgentRun {
  id                 String          @id
  sessionId          String          @map("session_id")
  inputMessageId     String          @map("input_message_id")
  assistantMessageId String          @map("assistant_message_id")
  status             AgentRunStatus  @default(queued)
  activeStepId       String?         @map("active_step_id")
  toolCallCount      Int             @default(0) @map("tool_call_count")
  lastEventSequence  BigInt          @default(0) @map("last_event_sequence")
  ownerInstanceId    String?         @map("owner_instance_id")
  heartbeatAt        DateTime?       @map("heartbeat_at")
  errorCode          String?         @map("error_code")
  errorDetail        String?         @map("error_detail")
  idempotencyKey     String          @map("idempotency_key")
  payloadHash        String          @map("payload_hash")
  version            Int             @default(0)
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")
  startedAt          DateTime?       @map("started_at")
  endedAt            DateTime?       @map("ended_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages           Message[]
  steps              AgentRunStep[]

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, status])
  @@map("agent_runs")
}

model AgentRunStep {
  id           String         @id
  runId        String         @map("run_id")
  sequence     Int
  kind         AgentStepKind
  status       AgentStepStatus
  attempt      Int            @default(1)
  toolCallId   String?        @map("tool_call_id")
  toolName     String?        @map("tool_name")
  input        Json?
  output       Json?
  errorCode    String?        @map("error_code")
  errorDetail  String?        @map("error_detail")
  startedAt    DateTime       @default(now()) @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  metadata     Json           @default("{}")
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@map("agent_run_steps")
}

enum AgentRunStatus {
  queued
  running
  cancel_requested
  completed
  failed
  cancelled
}

enum AgentStepKind {
  model
  tool
}

enum AgentStepStatus {
  running
  completed
  failed
  cancelled
}
