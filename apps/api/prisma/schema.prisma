generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  kind        String   @default("local")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  sessions    Session[]
  messages    Message[]
  files       File[]
  artifacts   Artifact[]
  artifactSeries ArtifactSeries[]
  reports     Report[]
  mcpServerConfigs McpServerConfig[]

  @@map("users")
}

enum MessageRole {
  user
  assistant
}

enum MessageKind {
  user_message
  assistant_delivery
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  title     String
  status    String    @default("active")
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  runs      AgentRun[]
  transcriptItems ModelTranscriptItem[]
  compactionState ContextCompactionState?
  pendingUserInputs PendingUserInput[]
  files     File[]
  artifacts Artifact[]
  artifactSeries ArtifactSeries[]
  reports Report[]
  sandboxInstance SandboxInstance?

  @@index([userId, isPinned(sort: Desc), updatedAt(sort: Desc)])
  @@map("sessions")
}

enum SandboxInstanceStatus {
  active
  stale
  destroying
}

model SandboxInstance {
  id                 String                @id @default(uuid())
  sessionId          String                @unique @map("session_id")
  providerSandboxId  String                @map("provider_sandbox_id")
  status             SandboxInstanceStatus @default(active)
  lastActiveAt       DateTime              @map("last_active_at")
  expiresAt          DateTime              @map("expires_at")
  hardExpiresAt      DateTime              @map("hard_expires_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  session            Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("sandbox_instances")
}

enum PendingUserInputKind {
  follow_up
  steer
}

enum PendingUserInputStatus {
  pending
  consumed
  rejected
  cancelled
}

model PendingUserInput {
  id             String                 @id
  sessionId      String                 @map("session_id")
  kind           PendingUserInputKind
  status         PendingUserInputStatus @default(pending)
  content        String
  sequence       Int
  idempotencyKey String                 @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  session        Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, status, kind, sequence])
  @@map("pending_user_inputs")
}

model ContextCompactionState {
  id                    String   @id
  sessionId             String   @unique @map("session_id")
  summary               String
  coveredMessageCount   Int      @map("covered_message_count")
  coveredUnitCount      Int?     @map("covered_unit_count")
  coveredThroughItemId  String?  @map("covered_through_item_id")
  version               Int      @default(1)
  tokenCount            Int      @map("token_count")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  session               Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("context_compaction_states")
}

model Message {
  id        String      @id
  userId    String      @map("user_id")
  sessionId String      @map("session_id")
  role      MessageRole
  kind      MessageKind
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  metadata  Json        @default("{}")
  runId     String?     @map("run_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run       AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  transcriptItems ModelTranscriptItem[]
  attachments MessageAttachment[]

  @@index([sessionId, createdAt])
  @@index([runId])
  @@map("messages")
}

enum FileStatus {
  processing
  ready
  failed
  rejected
}

enum FileKind {
  image
  text
  markdown
  csv
  json
  html
  pdf
  docx
  xlsx
  pptx
}

enum FileOrigin {
  user_uploaded
  agent_generated
  tool_result
}

enum ArtifactStatus {
  processing
  ready
  failed
  deleted
}

model File {
  id             String     @id
  userId         String     @map("user_id")
  sessionId      String     @map("session_id")
  fileName       String     @map("file_name")
  mediaType      String     @map("media_type")
  fileKind       FileKind   @map("file_kind")
  origin         FileOrigin @default(user_uploaded)
  size           Int
  sha256         String
  width          Int?
  height         Int?
  status         FileStatus @default(processing)
  errorCode      String?    @map("error_code")
  retryable      Boolean    @default(false)
  originalKey    String?    @map("original_key")
  previewKey     String?    @map("preview_key")
  // 规范化正文保存在 COS，数据库只保留对象引用，不保存正文主存储。
  normalizedKey  String?    @map("normalized_key")
  contentHash    String?    @map("content_hash")
  parserVersion  String?    @map("parser_version")
  pageCount      Int?       @map("page_count")
  lineCount      Int?       @map("line_count")
  characterCount Int?       @map("character_count")
  // overview 保存格式摘要；行号/页码由规范化正文读取时确定性计算。
  overview       Json?      @map("overview")
  processingStartedAt DateTime? @map("processing_started_at")
  processingCompletedAt DateTime? @map("processing_completed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]
  artifact       Artifact?

  @@unique([sessionId, id])
  @@index([sessionId, status])
  @@map("files")
}

enum ArtifactOperation {
  create
  revise
  restore
}

model ArtifactSeries {
  id                String     @id
  userId            String     @map("user_id")
  sessionId         String     @map("session_id")
  logicalName       String     @map("logical_name")
  currentArtifactId String?    @unique @map("current_artifact_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  artifacts         Artifact[] @relation("ArtifactSeriesVersions")
  currentArtifact   Artifact?  @relation("ArtifactSeriesCurrent", fields: [currentArtifactId], references: [id], onDelete: SetNull)

  @@index([sessionId, updatedAt(sort: Desc)])
  @@map("artifact_series")
}

model Artifact {
  id         String         @id
  fileId     String         @unique @map("file_id")
  userId     String         @map("user_id")
  sessionId  String         @map("session_id")
  runId      String         @map("run_id")
  toolCallId String         @map("tool_call_id")
  seriesId   String         @map("series_id")
  versionNumber Int         @map("version_number")
  parentArtifactId String?  @map("parent_artifact_id")
  sourceArtifactId String?  @map("source_artifact_id")
  operation ArtifactOperation @default(create)
  changeSummary String?     @map("change_summary")
  status     ArtifactStatus @default(processing)
  errorCode  String?        @map("error_code")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  file       File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run        AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  series     ArtifactSeries @relation("ArtifactSeriesVersions", fields: [seriesId], references: [id], onDelete: Cascade)
  currentFor ArtifactSeries? @relation("ArtifactSeriesCurrent")
  parent     Artifact?      @relation("ArtifactParent", fields: [parentArtifactId], references: [id], onDelete: Restrict)
  children   Artifact[]     @relation("ArtifactParent")
  source     Artifact?      @relation("ArtifactSource", fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  restorations Artifact[]   @relation("ArtifactSource")
  report     Report?

  @@unique([runId, toolCallId])
  @@unique([seriesId, versionNumber])
  @@index([sessionId])
  @@index([runId])
  @@index([seriesId, createdAt])
  @@map("artifacts")
}

enum ReportStatus {
  ready
  deleted
}
model Report {
  id String @id
  artifactId String @unique @map("artifact_id")
  runId String @map("run_id")
  userId String @map("user_id")
  sessionId String @map("session_id")
  title String
  summary String
  sourceIds Json @map("source_ids")
  fileIds Json @map("file_ids")
  status ReportStatus @default(ready)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@index([runId])
  @@map("reports")
}

enum FileCleanupStatus {
  pending
  completed
  failed
}

model FileCleanupTask {
  // COS 删除失败时保留独立补偿任务，避免依赖 File 必须存在。
  id          String            @id
  sessionId   String            @map("session_id")
  fileId      String            @map("file_id")
  status      FileCleanupStatus @default(pending)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([sessionId, fileId])
  @@index([status, updatedAt])
  @@map("file_cleanup_tasks")
}

model MessageAttachment {
  id        String   @id
  messageId String   @map("message_id")
  fileId    String   @map("file_id")
  ordinal   Int
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, ordinal])
  @@unique([messageId, fileId])
  @@index([fileId])
  @@map("message_attachments")
}

model AgentRun {
  id                 String          @id
  sessionId          String          @map("session_id")
  inputMessageId     String          @map("input_message_id")
  assistantMessageId String          @map("assistant_message_id")
  status             AgentRunStatus  @default(queued)
  activeStepId       String?         @map("active_step_id")
  toolCallCount      Int             @default(0) @map("tool_call_count")
  lastEventSequence  BigInt          @default(0) @map("last_event_sequence")
  ownerInstanceId    String?         @map("owner_instance_id")
  heartbeatAt        DateTime?       @map("heartbeat_at")
  errorCode          String?         @map("error_code")
  errorDetail        String?         @map("error_detail")
  idempotencyKey     String          @map("idempotency_key")
  payloadHash        String          @map("payload_hash")
  version            Int             @default(0)
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")
  startedAt          DateTime?       @map("started_at")
  endedAt            DateTime?       @map("ended_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages           Message[]
  steps              AgentRunStep[]
  transcriptItems    ModelTranscriptItem[]
  artifacts          Artifact[]
  reports            Report[]
  provider           String
  model              String
  reasoningEffort    String          @map("reasoning_effort")
  reasoningFormat    String?         @map("reasoning_format")

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, status])
  @@map("agent_runs")
}

enum TranscriptItemKind {
  user
  assistant
  tool_result
  clarification_request
  clarification_response
}

enum TranscriptItemState {
  active
  committed
}

model ModelTranscriptItem {
  id              String              @id
  sessionId       String              @map("session_id")
  runId           String?             @map("run_id")
  messageId       String?             @map("message_id")
  sequence        Int
  runSequence     Int                 @map("run_sequence")
  kind            TranscriptItemKind
  state           TranscriptItemState @default(active)
  content         String?
  reasoning       String?
  toolCalls       Json?               @map("tool_calls")
  toolCallId      String?             @map("tool_call_id")
  metadata        Json?
  provider        String
  model           String
  reasoningEffort String               @map("reasoning_effort")
  reasoningFormat String?              @map("reasoning_format")
  schemaVersion   Int                  @default(1) @map("schema_version")
  createdAt       DateTime             @default(now()) @map("created_at")
  session         Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run             AgentRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  message         Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@unique([runId, runSequence])
  @@index([sessionId, state, sequence])
  @@index([messageId])
  @@map("model_transcript_items")
}

model AgentRunStep {
  id           String         @id
  runId        String         @map("run_id")
  sequence     Int
  kind         AgentStepKind
  status       AgentStepStatus
  attempt      Int            @default(1)
  toolCallId   String?        @map("tool_call_id")
  toolName     String?        @map("tool_name")
  input        Json?
  output       Json?
  errorCode    String?        @map("error_code")
  errorDetail  String?        @map("error_detail")
  startedAt    DateTime       @default(now()) @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  metadata     Json           @default("{}")
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@map("agent_run_steps")
}

enum AgentRunStatus {
  queued
  running
  cancel_requested
  completed
  failed
  cancelled
}

enum AgentStepKind {
  model
  tool
}

enum AgentStepStatus {
  running
  completed
  failed
  cancelled
}

enum McpTransport {
  streamable_http
}

enum McpDefaultApproval {
  auto_execute
  require_approval
}

enum McpSecretKind {
  header
  env
  bearer
}

model McpServerConfig {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  sessionId            String?            @map("session_id")
  serverName           String             @map("server_name")
  enabled              Boolean            @default(true)
  transport            McpTransport       @default(streamable_http)
  url                  String
  headersPlain         Json               @default("{}") @map("headers_plain")
  startupTimeoutMs     Int                @default(30000) @map("startup_timeout_ms")
  toolCallTimeoutMs    Int                @default(60000) @map("tool_call_timeout_ms")
  required             Boolean            @default(false)
  failOnStartupError   Boolean            @default(false) @map("fail_on_startup_error")
  defaultApproval      McpDefaultApproval @default(require_approval) @map("default_approval")
  enabledTools         Json?              @map("enabled_tools")
  disabledTools        Json?              @map("disabled_tools")
  maxInstructionBytes  Int                @default(32768) @map("max_instruction_bytes")
  reconnectEnabled     Boolean            @default(true) @map("reconnect_enabled")
  reconnectMaxAttempts Int                @default(5) @map("reconnect_max_attempts")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  secrets              McpServerSecret[]

  @@unique([userId, sessionId, serverName])
  @@index([userId, enabled])
  @@map("mcp_server_configs")
}

model McpServerSecret {
  id                 String           @id @default(uuid())
  mcpServerConfigId  String           @map("mcp_server_config_id")
  kind               McpSecretKind
  name               String
  ciphertext         String           @db.Text
  nonce              String
  keyVersion         Int              @default(1) @map("key_version")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  config             McpServerConfig  @relation(fields: [mcpServerConfigId], references: [id], onDelete: Cascade)

  @@unique([mcpServerConfigId, kind, name])
  @@map("mcp_server_secrets")
}
