generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  kind        String   @default("local")
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  sessions    Session[]
  messages    Message[]
  files       File[]

  @@map("users")
}

enum MessageRole {
  user
  assistant
}

enum MessageKind {
  user_message
  assistant_delivery
}

model Session {
  id        String    @id
  userId    String    @map("user_id")
  title     String
  status    String    @default("active")
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  runs      AgentRun[]
  transcriptItems ModelTranscriptItem[]
  compactionState ContextCompactionState?
  pendingUserInputs PendingUserInput[]
  files     File[]

  @@index([userId, isPinned(sort: Desc), updatedAt(sort: Desc)])
  @@map("sessions")
}

enum PendingUserInputKind {
  follow_up
  steer
}

enum PendingUserInputStatus {
  pending
  consumed
  rejected
  cancelled
}

model PendingUserInput {
  id             String                 @id
  sessionId      String                 @map("session_id")
  kind           PendingUserInputKind
  status         PendingUserInputStatus @default(pending)
  content        String
  sequence       Int
  idempotencyKey String                 @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  session        Session                @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, status, kind, sequence])
  @@map("pending_user_inputs")
}

model ContextCompactionState {
  id                    String   @id
  sessionId             String   @unique @map("session_id")
  summary               String
  coveredMessageCount   Int      @map("covered_message_count")
  coveredThroughItemId  String?  @map("covered_through_item_id")
  version               Int      @default(1)
  tokenCount            Int      @map("token_count")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  session               Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("context_compaction_states")
}

model Message {
  id        String      @id
  userId    String      @map("user_id")
  sessionId String      @map("session_id")
  role      MessageRole
  kind      MessageKind
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  metadata  Json        @default("{}")
  runId     String?     @map("run_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run       AgentRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  transcriptItems ModelTranscriptItem[]
  attachments MessageAttachment[]

  @@index([sessionId, createdAt])
  @@index([runId])
  @@map("messages")
}

enum FileStatus {
  processing
  ready
  failed
  rejected
}

model File {
  id             String     @id
  userId         String     @map("user_id")
  sessionId      String     @map("session_id")
  fileName       String     @map("file_name")
  mediaType      String     @map("media_type")
  size           Int
  sha256         String
  width          Int
  height         Int
  status         FileStatus @default(processing)
  errorCode      String?    @map("error_code")
  retryable      Boolean    @default(false)
  originalKey    String?    @map("original_key")
  previewKey     String?    @map("preview_key")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@unique([sessionId, id])
  @@index([sessionId, status])
  @@map("files")
}

model MessageAttachment {
  id        String   @id
  messageId String   @map("message_id")
  fileId    String   @map("file_id")
  ordinal   Int
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, ordinal])
  @@unique([messageId, fileId])
  @@index([fileId])
  @@map("message_attachments")
}

model AgentRun {
  id                 String          @id
  sessionId          String          @map("session_id")
  inputMessageId     String          @map("input_message_id")
  assistantMessageId String          @map("assistant_message_id")
  status             AgentRunStatus  @default(queued)
  activeStepId       String?         @map("active_step_id")
  toolCallCount      Int             @default(0) @map("tool_call_count")
  lastEventSequence  BigInt          @default(0) @map("last_event_sequence")
  ownerInstanceId    String?         @map("owner_instance_id")
  heartbeatAt        DateTime?       @map("heartbeat_at")
  errorCode          String?         @map("error_code")
  errorDetail        String?         @map("error_detail")
  idempotencyKey     String          @map("idempotency_key")
  payloadHash        String          @map("payload_hash")
  version            Int             @default(0)
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")
  startedAt          DateTime?       @map("started_at")
  endedAt            DateTime?       @map("ended_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages           Message[]
  steps              AgentRunStep[]
  transcriptItems    ModelTranscriptItem[]
  provider           String
  model              String
  reasoningEffort    String          @map("reasoning_effort")
  reasoningFormat    String?         @map("reasoning_format")

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, status])
  @@map("agent_runs")
}

enum TranscriptItemKind {
  user
  assistant
  tool_result
  clarification_request
  clarification_response
}

enum TranscriptItemState {
  active
  committed
}

model ModelTranscriptItem {
  id              String              @id
  sessionId       String              @map("session_id")
  runId           String?             @map("run_id")
  messageId       String?             @map("message_id")
  sequence        Int
  runSequence     Int                 @map("run_sequence")
  kind            TranscriptItemKind
  state           TranscriptItemState @default(active)
  content         String?
  reasoning       String?
  toolCalls       Json?               @map("tool_calls")
  toolCallId      String?             @map("tool_call_id")
  metadata        Json?
  provider        String
  model           String
  reasoningEffort String               @map("reasoning_effort")
  reasoningFormat String?              @map("reasoning_format")
  schemaVersion   Int                  @default(1) @map("schema_version")
  createdAt       DateTime             @default(now()) @map("created_at")
  session         Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  run             AgentRun?            @relation(fields: [runId], references: [id], onDelete: SetNull)
  message         Message?             @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@unique([runId, runSequence])
  @@index([sessionId, state, sequence])
  @@index([messageId])
  @@map("model_transcript_items")
}

model AgentRunStep {
  id           String         @id
  runId        String         @map("run_id")
  sequence     Int
  kind         AgentStepKind
  status       AgentStepStatus
  attempt      Int            @default(1)
  toolCallId   String?        @map("tool_call_id")
  toolName     String?        @map("tool_name")
  input        Json?
  output       Json?
  errorCode    String?        @map("error_code")
  errorDetail  String?        @map("error_detail")
  startedAt    DateTime       @default(now()) @map("started_at")
  endedAt      DateTime?      @map("ended_at")
  metadata     Json           @default("{}")
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@map("agent_run_steps")
}

enum AgentRunStatus {
  queued
  running
  cancel_requested
  completed
  failed
  cancelled
}

enum AgentStepKind {
  model
  tool
}

enum AgentStepStatus {
  running
  completed
  failed
  cancelled
}
