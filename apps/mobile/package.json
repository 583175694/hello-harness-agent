{
  "name": "@harness/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:clear": "expo start --clear",
    "start:dev-client:clear": "expo start --dev-client --clear",
    "start:localhost": "expo start --localhost",
    "android": "expo run:android",
    "ios": "node scripts/open-ios-simulator.mjs && expo start --ios --localhost",
    "ios:open": "node scripts/open-ios-simulator.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:maestro:preflight": "bash scripts/maestro-preflight.sh",
    "test:maestro": "bash scripts/maestro-preflight.sh && maestro test maestro/p2-smoke.yaml",
    "test:maestro:run": "maestro test maestro/p2-smoke.yaml maestro/session-switch.yaml maestro/settings-api-ready.yaml maestro/settings-mcp.yaml maestro/kill-relaunch.yaml maestro/workbench-open.yaml",
    "test:maestro:all": "bash scripts/maestro-preflight.sh && pnpm test:maestro:run",
    "test:maestro:e2e": "bash scripts/run-maestro-e2e.sh",
    "snapshot:compare": "bash scripts/snapshot-compare.sh",
    "test:maestro:syntax": "maestro check-syntax maestro/p2-smoke.yaml && maestro check-syntax maestro/session-switch.yaml && maestro check-syntax maestro/settings-api-ready.yaml && maestro check-syntax maestro/settings-mcp.yaml && maestro check-syntax maestro/kill-relaunch.yaml && maestro check-syntax maestro/workbench-open.yaml",
    "ios:dev-build": "expo run:ios",
    "ios:simulator:eas": "bash scripts/eas-simulator-build.sh",
    "ios:simulator:install": "bash scripts/install-eas-simulator-app.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "gate:engineering": "pnpm typecheck && pnpm lint && pnpm test",
    "gate:release-prep": "bash scripts/gate-release-prep.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@harness/agent-client": "workspace:*",
    "@harness/agent-conversation": "workspace:*",
    "@harness/agent-projection": "workspace:*",
    "@harness/agent-protocol": "workspace:*",
    "@harness/agent-run-state": "workspace:*",
    "@harness/agent-ui-types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "@shopify/flash-list": "2.0.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^0.562.0",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
