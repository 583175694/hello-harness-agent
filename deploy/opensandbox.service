[Unit]
Description=OpenSandbox Server (Docker backend)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/opensandbox
ExecStart=/home/ubuntu/opensandbox/.venv/bin/opensandbox-server --config /home/ubuntu/opensandbox/sandbox.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SupplementaryGroups=docker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/opensandbox /var/lib/opensandbox

[Install]
WantedBy=multi-user.target
