{
  "name": "hello-harness-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @harness/agent-protocol --filter @harness/agent-ui-types --filter @harness/agent-client --filter @harness/agent-conversation --filter @harness/agent-projection --filter @harness/agent-run-state --filter @harness/bundled-skills --filter @harness/deepseek-v3-tokenizer build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @harness/agent-protocol --filter @harness/agent-ui-types --filter @harness/agent-client --filter @harness/agent-conversation --filter @harness/agent-projection --filter @harness/agent-run-state --filter @harness/bundled-skills --filter @harness/deepseek-v3-tokenizer build && pnpm -r --if-present test && pnpm --filter @harness/mobile test",
    "test:integration": "pnpm --filter @harness/api test:integration",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "validate:gate-a": "pnpm --filter @harness/mobile-contract validate:gate-a",
    "gate-a:verify:android": "pnpm validate:gate-a && bash apps/android/scripts/sync-mobile-contract.sh && cd apps/android && ./gradlew :app:verifyPaparazziPreviewDebug --no-daemon",
    "gate-a:verify:ios": "pnpm validate:gate-a && cd apps/ios && xcodegen generate && xcodebuild test -scheme Harness -destination 'platform=iOS Simulator,name=iPhone 17' -only-testing:HarnessTests CODE_SIGNING_ALLOWED=NO",
    "gate-a:verify:harmony": "pnpm validate:gate-a && bash apps/harmony/scripts/sync-mobile-contract.sh && node apps/harmony/scripts/assert-preview-fixtures.mjs",
    "gate-a:verify": "pnpm gate-a:verify:android",
    "gate-a:verify:all": "pnpm validate:gate-a && bash apps/android/scripts/sync-mobile-contract.sh && (cd apps/android && ./gradlew :app:verifyPaparazziPreviewDebug --no-daemon) && bash apps/harmony/scripts/sync-mobile-contract.sh && node apps/harmony/scripts/assert-preview-fixtures.mjs && (cd apps/ios && xcodegen generate && xcodebuild test -scheme Harness -destination 'platform=iOS Simulator,name=iPhone 17' -only-testing:HarnessTests CODE_SIGNING_ALLOWED=NO)",
    "gate-a:list-snapshot-baselines": "pnpm --filter @harness/mobile-contract list:gate-a-snapshot-baselines",
    "gate-a:prep-commit": "bash scripts/gate-a-prep-commit.sh",
    "gate-a:audit": "bash scripts/gate-a-audit.sh",
    "gate-a:completion": "node packages/mobile-contract/scripts/report-gate-a-completion.mjs",
    "gate-a:human-evidence": "node packages/mobile-contract/scripts/verify-gate-a-human-evidence.mjs",
    "gate-a:benchmark:android": "bash apps/android/scripts/run-gate-a-long-thread-benchmark.sh",
    "gate-a:benchmark:android:summary": "node apps/android/scripts/print-gate-a-benchmark-summary.mjs",
    "gate-a:benchmark:ios": "bash apps/ios/scripts/run-gate-a-long-thread-scroll.sh",
    "gate-a:benchmark:ios:summary": "node apps/ios/scripts/print-gate-a-ios-scroll-summary.mjs",
    "gate-a:launch:android": "bash apps/android/scripts/launch-preview.sh",
    "gate-a:launch:android:release": "bash apps/android/scripts/launch-preview-release.sh",
    "gate-a:launch:ios": "bash apps/ios/scripts/launch-preview.sh",
    "gate-a:launch:harmony": "bash apps/harmony/scripts/sync-mobile-contract.sh",
    "dev:mobile": "pnpm --filter @harness/mobile start:dev-client",
    "gate:mobile": "pnpm --filter @harness/mobile gate:release-prep",
    "smoke:api": "pnpm --filter @harness/mobile smoke:api",
    "ios:simulator:eas": "pnpm --filter @harness/mobile ios:simulator:eas",
    "test:maestro:syntax": "pnpm --filter @harness/mobile test:maestro:syntax",
    "test:maestro:preflight": "pnpm --filter @harness/mobile test:maestro:preflight",
    "test:maestro:e2e": "pnpm --filter @harness/mobile test:maestro:e2e",
    "setup": "node scripts/run-db.mjs setup",
    "db": "node scripts/run-db.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
